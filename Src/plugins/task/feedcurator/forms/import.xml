<?xml version="1.0" encoding="UTF-8"?>
<form>
    <fields name="params">
        <fieldset name="task_params">
            <field name="sources" type="subform" multiple="true" required="true"
                label="PLG_TASK_FEEDCURATOR_SOURCES_LABEL" description="PLG_TASK_FEEDCURATOR_SOURCES_DESC">
                <form>
                    <field name="name" type="text" required="true"
                        label="PLG_TASK_FEEDCURATOR_SOURCE_NAME_LABEL" description="PLG_TASK_FEEDCURATOR_SOURCE_NAME_DESC"/>
                    <field name="url" type="url" required="true" validate="url" filter="url" schemes="https"
                        label="PLG_TASK_FEEDCURATOR_SOURCE_URL_LABEL" description="PLG_TASK_FEEDCURATOR_SOURCE_URL_DESC"/>
                    <field name="filter" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
                        label="PLG_TASK_FEEDCURATOR_SOURCE_FILTER_LABEL" description="PLG_TASK_FEEDCURATOR_SOURCE_FILTER_DESC">
                        <option value="0">JNO</option>
                        <option value="1">JYES</option>
                    </field>
                    <field name="keywords" type="textarea" rows="4" filter="raw"
                        label="PLG_TASK_FEEDCURATOR_SOURCE_KEYWORDS_LABEL" description="PLG_TASK_FEEDCURATOR_SOURCE_KEYWORDS_DESC"/>
                    <field name="exclude" type="textarea" rows="4" filter="raw"
                        label="PLG_TASK_FEEDCURATOR_SOURCE_EXCLUDE_LABEL" description="PLG_TASK_FEEDCURATOR_SOURCE_EXCLUDE_DESC"/>
                    <field name="enabled" type="radio" layout="joomla.form.field.radio.switcher" default="1" filter="integer"
                        label="PLG_TASK_FEEDCURATOR_SOURCE_ENABLED_LABEL" description="PLG_TASK_FEEDCURATOR_SOURCE_ENABLED_DESC">
                        <option value="0">JNO</option>
                        <option value="1">JYES</option>
                    </field>
                </form>
            </field>
            <field name="keywords" type="textarea" rows="8" filter="raw"
                label="PLG_TASK_FEEDCURATOR_KEYWORDS_LABEL" description="PLG_TASK_FEEDCURATOR_KEYWORDS_DESC"/>
            <field name="catid" type="category" extension="com_content" required="true" filter="integer"
                label="PLG_TASK_FEEDCURATOR_CATID_LABEL" description="PLG_TASK_FEEDCURATOR_CATID_DESC"/>
            <field name="created_by" type="user" filter="integer"
                label="PLG_TASK_FEEDCURATOR_CREATED_BY_LABEL" description="PLG_TASK_FEEDCURATOR_CREATED_BY_DESC"/>
            <field name="max_age_days" type="number" default="30" min="1" max="365" step="1" filter="integer"
                label="PLG_TASK_FEEDCURATOR_MAX_AGE_DAYS_LABEL" description="PLG_TASK_FEEDCURATOR_MAX_AGE_DAYS_DESC"/>
            <field name="max_per_run" type="number" default="10" min="1" max="100" step="1" filter="integer"
                label="PLG_TASK_FEEDCURATOR_MAX_PER_RUN_LABEL" description="PLG_TASK_FEEDCURATOR_MAX_PER_RUN_DESC"/>
            <field name="first_run_weeks" type="number" default="0" min="0" max="52" step="1" filter="integer"
                label="PLG_TASK_FEEDCURATOR_FIRST_RUN_WEEKS_LABEL" description="PLG_TASK_FEEDCURATOR_FIRST_RUN_WEEKS_DESC"/>
            <field name="notify_groups" type="usergrouplist" multiple="true"
                label="PLG_TASK_FEEDCURATOR_NOTIFY_GROUPS_LABEL" description="PLG_TASK_FEEDCURATOR_NOTIFY_GROUPS_DESC"/>
            <field name="site_url" type="url" required="true" validate="url" filter="url" schemes="https,http"
                label="PLG_TASK_FEEDCURATOR_SITE_URL_LABEL" description="PLG_TASK_FEEDCURATOR_SITE_URL_DESC"/>
            <field name="link_days" type="number" default="7" min="1" max="30" step="1" filter="integer"
                label="PLG_TASK_FEEDCURATOR_LINK_DAYS_LABEL" description="PLG_TASK_FEEDCURATOR_LINK_DAYS_DESC"/>
            <field name="notify_after" type="number" default="3" min="1" max="24" step="1" filter="integer"
                label="PLG_TASK_FEEDCURATOR_NOTIFY_AFTER_LABEL" description="PLG_TASK_FEEDCURATOR_NOTIFY_AFTER_DESC"/>
        </fieldset>
    </fields>
</form>
